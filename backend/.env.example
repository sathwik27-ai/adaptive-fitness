# Required. Local MongoDB example; use your own Atlas URI if preferred.
MONGO_URI=mongodb://127.0.0.1:27017/adaptive_fitness

# Required. Replace this placeholder with a random secret; see SETUP.md.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional server settings
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
JWT_EXPIRES_IN=7d
COOKIE_SECRET=

# Optional Google login and Google Fit. Set both credentials together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Optional Facebook login. Set both credentials together.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# Optional workout image uploads. Configure all three values together.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional welcome email. Use a Gmail App Password, not your account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional AI meal-plan and insight generation.
HUGGING_FACE_API_KEY=
